{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "simulator": {
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK": "1"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "channel": "preview"
    },
    "production": {
      "ios": {
        "simulator": false
      },
      "channel": "production"
    },
    "unsigned-ipa": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "local"
      },
      "channel": "preview"
    },
    "dev-ipa": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "credentialsSource": "local"
      },
      "channel": "preview"
    }
  }
}
